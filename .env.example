# Required only for live SEC downloads. Use your real name and contact address.
SEC_USER_AGENT="Your Name your_email@example.com"

# Optional keyed providers.
FRED_API_KEY=""
ALPHA_VANTAGE_API_KEY=""

NOWCASTER_MODE="live"
NOWCASTER_DATABASE_URL="duckdb:///data/nowcaster.duckdb"
NOWCASTER_LOG_LEVEL="INFO"
# Alpaca paper credentials are read only from the launched process environment.
APCA_API_KEY_ID=<local-paper-key>
APCA_API_SECRET_KEY=<local-paper-secret>
